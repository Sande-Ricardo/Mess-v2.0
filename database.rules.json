{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid",
        "conversations": {
          "$convId": {
            ".write": "auth != null"
          }
        },
        "groups": {
          "$groupId": {
            ".write": "auth != null"
          }
        }
      }
    },
    "usernames": {
      "$username": {
        ".read": true,
        ".write": "auth != null && !data.exists()"
      }
    },
    "conversations": {
      "$convId": {
        ".read": "auth != null && ($convId.beginsWith('grp_') ? root.child('groups').child($convId).child('members').child(auth.uid).exists() : data.child('metadata/participants/' + auth.uid).val() == true)",
        ".write": "auth != null && ($convId.beginsWith('grp_') ? root.child('groups').child($convId).child('members').child(auth.uid).exists() : (data.child('metadata/participants/' + auth.uid).val() == true || newData.child('metadata/participants/' + auth.uid).val() == true))"
      }
    },
    "groups": {
      "$groupId": {
        "metadata": {
          ".read": "auth != null && root.child('groups').child($groupId).child('members').child(auth.uid).exists()",
          ".write": "auth != null && (!data.exists() || root.child('groups').child($groupId).child('members').child(auth.uid).child('role').val() == 'admin')",
          "memberCount": {
            ".validate": "newData.isNumber() && newData.val() <= 256"
          }
        },
        "members": {
          "$uid": {
            ".read": "auth != null && root.child('groups').child($groupId).child('members').child(auth.uid).exists()",
            ".write": "auth != null && (root.child('groups').child($groupId).child('members').child(auth.uid).child('role').val() == 'admin' || (auth.uid == $uid && !newData.exists()) || !root.child('groups').child($groupId).child('metadata').exists())"
          }
        },
        "messages": {
          ".read": "auth != null && root.child('groups').child($groupId).child('members').child(auth.uid).exists()",
          "$msgId": {
            ".write": "auth != null && root.child('groups').child($groupId).child('members').child(auth.uid).exists()"
          }
        }
      }
    },
    "calls": {
      "$callId": {
        ".read": "auth != null && (data.child('caller').val() == auth.uid || data.child('callee').val() == auth.uid)",
        ".write": "auth != null && (!data.exists() || data.child('caller').val() == auth.uid || data.child('callee').val() == auth.uid || newData.child('caller').val() == auth.uid || newData.child('callee').val() == auth.uid)"
      }
    },
    "group-calls": {
      "$groupId": {
        ".read": "auth != null && root.child('groups').child($groupId).child('members').child(auth.uid).exists()",
        ".write": "auth != null && root.child('groups').child($groupId).child('members').child(auth.uid).exists()"
      }
    },
    "inviteTokens": {
      "$token": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "typing": {
      "$convId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid"
        }
      }
    },
    ".read": "false",
    ".write": "false"
  }
}
