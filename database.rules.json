{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "usernames": {
      "$username": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists()"
      }
    },
    "conversations": {
      "$convId": {
        ".read": "auth != null && data.child('metadata/participants/' + auth.uid).val() === true",
        ".write": "auth != null && (data.child('metadata/participants/' + auth.uid).val() === true || newData.child('metadata/participants/' + auth.uid).val() === true)"
      }
    },
    ".read": false,
    ".write": false
  }
}
